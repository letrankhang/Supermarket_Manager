# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env - nó chứa mật khẩu.

# Database Type Selection: 'mysql' or 'mssql' (SQL Server)
DB_TYPE=mysql

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=supermarket_db

# SQL Server (MSSQL) Configuration
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_NAME=supermarket_db

# Connection Pool Settings (For MySQL)
DB_POOL_NAME=supermarket_pool
DB_POOL_SIZE=5

# ===== Tham so nghiep vu POS (ban hang) =====
# Thue suat VAT: 0.08 = 8%
VAT_RATE=0.08
# Muc giam gia mac dinh cho moi hoa don: 0.0 = khong giam
DEFAULT_DISCOUNT_RATE=0.0
# Muc giam gia toi da thu ngan duoc phep nhap tay: 0.5 = 50%
MAX_DISCOUNT_RATE=0.5
# Nguong canh bao sap het hang
LOW_STOCK_THRESHOLD=10
# So san pham toi da nap len luoi moi lan
PRODUCT_PAGE_SIZE=60

# ============ Cau hinh gui email (quen mat khau) ============
# Gmail: bat xac thuc 2 buoc roi tao "App password" 16 ky tu tai
# https://myaccount.google.com/apppasswords
# Dan mat khau ung dung do vao EMAIL_PASSWORD (KHONG dung mat khau tai khoan).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

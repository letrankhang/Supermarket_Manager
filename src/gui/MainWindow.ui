}

/* 2. Định dạng các nút bấm */
#sidebar_frame QPushButton {
    color: #cbd5e1;                
    text-align: left;              
    padding: 10px 10px 10px 30px;  
    border: none;                  
    font-size: 13px;               
    font-weight: bold;             
}

/* 3. Hiệu ứng Hover cho nút */

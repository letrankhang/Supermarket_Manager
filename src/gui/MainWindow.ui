    background-color: #475569;     
    color: #ffffff;                
    border-left: 4px solid #3b82f6;
}

/* 4. Đổi màu chữ Logo và Tiêu đề thành trắng cho nổi bật */
#sidebar_frame QLabel {
    color: #ffffff;
    font-weight: bold;
}</string>

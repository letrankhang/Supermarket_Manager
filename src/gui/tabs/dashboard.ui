  <property name="styleSheet">
   <string notr="true">/* ===== QSS tập trung của Dashboard =====
   Trước đây nằm rải rác trong DashboardController.py.
   Gom về đây để chỉnh giao diện trực tiếp trong Qt Designer.
   QSS đặt ở widget gốc sẽ lan xuống mọi widget con, kể cả
   widget được tạo lúc chạy (bảng, huy hiệu icon, nhãn ô thao tác). */

/* Nút &quot;Tải lại dữ liệu&quot; trên thanh tiêu đề */
QPushButton#pushButton {
	background-color: #3b82f6;
	color: white;
	border: none;
	border-radius: 5px;
	padding: 6px 12px;
	font-weight: bold;
}
QPushButton#pushButton:hover {
	background-color: #2563eb;
}

/* Tiêu đề khối &quot;Giao dịch gần đây&quot; */
QLabel#lblTableTitle {
	font-weight: bold;
	font-size: 14px;
	color: #1e293b;
}

/* Bảng giao dịch gần đây */
QTableWidget#tblRecentTransactions {
	border: none;
	gridline-color: #f1f5f9;
	background-color: white;
}
QTableWidget#tblRecentTransactions::item {
	padding: 10px;
	border-bottom: 1px solid #f8fafc;
}
QTableWidget#tblRecentTransactions QHeaderView::section {
	background-color: #f8fafc;
	padding: 8px;
	font-weight: bold;
	border: none;
	color: #475569;
}

/* Chữ chú thích dưới 4 ô thao tác nhanh */
QLabel#lblQuickActionCaption {
	font-size: 12px;
	font-weight: bold;
	color: #475569;
}

/* Huy hiệu nền bo góc phía sau icon của 4 thẻ thống kê */
QLabel#badgeRevenue  { background-color: #dbeafe; border-radius: 8px; }
QLabel#badgeInvoice  { background-color: #ede9fe; border-radius: 8px; }
QLabel#badgeStock    { background-color: #fef3c7; border-radius: 8px; }
QLabel#badgeCustomer { background-color: #d1fae5; border-radius: 8px; }

/* Nhãn đổi màu theo dữ liệu.
   Controller chỉ gán thuộc tính động trangThai, màu do QSS dưới đây quyết định. */
QLabel[trangThai=&quot;tang&quot;]    { color: #10b981; font-weight: bold; }
QLabel[trangThai=&quot;giam&quot;]    { color: #ef4444; font-weight: bold; }
QLabel[trangThai=&quot;giu&quot;]     { color: #64748b; font-weight: bold; }
QLabel[trangThai=&quot;canhBao&quot;] { color: #eab308; font-weight: bold; }
QLabel[trangThai=&quot;anToan&quot;]  { color: #10b981; }</string>
  </property>

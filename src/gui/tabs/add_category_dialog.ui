  <property name="styleSheet">
   <string notr="true">
QDialog#CategoryManagerDialog {
    background-color: #f1f5f9;
    color: #0f172a;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}
QWidget#widgetBody {
    background-color: transparent;
}
QLabel {
    background-color: transparent;
    border: none;
    color: #0f172a;
}

QLabel#lblHeaderTitle {
    color: #0f172a;
    padding: 0px;
    margin: 0px;
}
QLabel#lblHeaderSubtitle {
    color: #6b7280;
    font-size: 12px;
    font-weight: normal;
    margin-top: 4px;
}

QLabel#lblFormTitle {
    color: #0f172a;
    font-size: 13px;
    font-weight: 700;
}

QFrame#frameTableCard,
QFrame#frameFormCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}
QFrame#lineSeparator {
    color: #e2e8f0;
    background-color: #e2e8f0;
    border: none;
}

QTableWidget#tblCategories {
    background-color: transparent;
    border: none;
    gridline-color: #f1f5f9;
    font-size: 13px;
    color: #334155;
    outline: none;
}
QTableWidget#tblCategories::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget#tblCategories::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}
QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
}

QLabel#lblCategoryName,
QLabel#lblDescription {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}

QLineEdit#txtCategoryName {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 12px;
    min-height: 38px;
    font-size: 13px;
    color: #0f172a;
}
QTextEdit#txtDescription {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    color: #0f172a;
}
QLineEdit#txtCategoryName:focus,
QTextEdit#txtDescription:focus {
    border: 1px solid #1d4ed8;
}

QPushButton#btnEditCategory {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 34px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#btnEditCategory:hover {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #1d4ed8;
}
QPushButton#btnDeleteCategory {
    background-color: #ffffff;
    color: #dc2626;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 34px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#btnDeleteCategory:hover {
    background-color: #fef2f2;
    border: 1px solid #dc2626;
}
QPushButton#btnEditCategory:disabled,
QPushButton#btnDeleteCategory:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border: 1px solid #e2e8f0;
}

QPushButton#btnSave {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0px 20px;
    min-height: 38px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#btnSave:hover {
    background-color: #1d4ed8;
}
QPushButton#btnSave:pressed {
    background-color: #1e40af;
}
QPushButton#btnSave:disabled {
    background-color: #cbd5e1;
    color: #f8fafc;
}
QPushButton#btnCancel {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 20px;
    min-height: 38px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#btnCancel:hover {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #1d4ed8;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    min-height: 35px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}
QScrollBar::handle:vertical:pressed {
    background-color: #64748b;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    min-width: 35px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #64748b;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}</string>

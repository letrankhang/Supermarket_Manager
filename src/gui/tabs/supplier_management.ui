    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[state=&quot;up&quot;] {
    color: #10b981;
    font-weight: bold;
}
QLabel[state=&quot;down&quot;] {
    color: #ef4444;
    font-weight: bold;
}
QLabel[state=&quot;flat&quot;] {

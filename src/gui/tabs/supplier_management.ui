    width: 9px;
    height: 9px;
}
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow {
    image: url(assets/images/chevron-down.png);
    width: 9px;
    height: 9px;
}

QCheckBox {
    background-color: transparent;
    color: #334155;
    font-size: 13px;
    font-weight: bold;

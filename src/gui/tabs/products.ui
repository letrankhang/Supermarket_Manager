  <property name="styleSheet">
   <string notr="true">
QWidget#SanPhamTab {
    background-color: #f1f5f9;
    color: #0f172a;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}
QLabel {
    background-color: transparent;
    border: none;
    color: #0f172a;
}

QLabel#lblTitle {
    color: #0f172a;
    padding: 0px;
    margin: 0px;
}
QLabel#lblSubtitle {
    color: #6b7280;
    font-size: 12px;
    font-weight: normal;
    margin-top: 4px;
}

QFrame#frameHeader,
QFrame#frameToolbar,
QFrame#framePagination {
    background-color: transparent;
    border: none;
}

QLineEdit#edtSearch {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 12px;
    min-height: 38px;
    font-size: 13px;
    color: #0f172a;
}
QLineEdit#edtSearch:focus {
    border: 1px solid #1d4ed8;
}
QComboBox#cbDanhMuc {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 12px;
    min-width: 150px;
    min-height: 38px;
    font-size: 13px;
    color: #334155;
}
QComboBox#cbDanhMuc:hover {
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}
QComboBox#cbDanhMuc QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;
}

QPushButton#btnsua,
QPushButton#btnThemdm {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 38px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#btnsua:hover,
QPushButton#btnThemdm:hover {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #1d4ed8;
}

QPushButton#btnXoa {
    background-color: #ffffff;
    color: #dc2626;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 16px;
    min-height: 38px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#btnXoa:hover {
    background-color: #fef2f2;
    border: 1px solid #dc2626;
}

QPushButton#btnThem {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0px 18px;
    min-height: 38px;
    font-size: 12px;
    font-weight: 700;
}
QPushButton#btnThem:hover {
    background-color: #1d4ed8;
}
QPushButton#btnThem:pressed {
    background-color: #1e40af;
}

QFrame#frameTable {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}
QTableWidget#tableSanPham {
    background-color: transparent;
    border: none;
    gridline-color: #f1f5f9;
    font-size: 13px;
    color: #334155;
    outline: none;
}
QTableWidget#tableSanPham::item {
    padding: 8px;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget#tableSanPham::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}
QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
}

QLabel[class=&quot;badgeSuccess&quot;] {
    background-color: #dbeafe;
    color: #1d4ed8;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[class=&quot;badgeWarning&quot;] {
    background-color: #ffedd5;
    color: #ea580c;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[class=&quot;badgeDanger&quot;] {
    background-color: #fee2e2;
    color: #dc2626;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#lblPage {
    color: #64748b;
    font-size: 12px;
}
QPushButton#btnPrev,
QPushButton#btnNext {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    min-width: 34px;
    max-width: 34px;
    min-height: 32px;
    max-height: 32px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#btnPrev:hover,
QPushButton#btnNext:hover {
    background-color: #eff6ff;
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}
QPushButton#btnPrev:disabled,
QPushButton#btnNext:disabled {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #cbd5e1;
}

QPushButton#PageNumberButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#PageNumberButton:hover {
    background-color: #eff6ff;
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}
QPushButton#PageNumberButton:checked {
    background-color: #1d4ed8;
    border: 1px solid #1d4ed8;
    color: #ffffff;
}
QPushButton#PageNumberButton:disabled {
    background-color: transparent;
    border: none;
    color: #94a3b8;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    min-height: 35px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}
QScrollBar::handle:vertical:pressed {
    background-color: #64748b;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    min-width: 35px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #64748b;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}</string>

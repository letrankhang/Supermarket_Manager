  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #ffffff;
}

QLabel {
    background-color: transparent;
    border: none;
    color: #0f172a;
}

#frame_topbar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

#lblScanSubtitle {
    color: #6b7280;
    font-size: 12px;
    font-weight: normal;
    margin-top: 4px;
}

#lblCashierName {
    color: #64748b;
}

#frame_filters {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 13px;
    color: #0f172a;
}

QLineEdit:focus {
    border: 1px solid #1d4ed8;
}

#CategoryChip {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 4px 16px;
    font-size: 12px;
    font-weight: bold;
}

#CategoryChip:hover {
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}

#CategoryChip:checked {
    background-color: #1e3a8a;
    color: #ffffff;
    border: 1px solid #1e3a8a;
}

#btnFilter,
#btnAddCustomer {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
}

#btnFilter:hover,
#btnAddCustomer:hover {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #1d4ed8;
}

#btnClearCart {
    background-color: #ffffff;
    color: #dc2626;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
}

#btnClearCart:hover {
    background-color: #fef2f2;
    border: 1px solid #dc2626;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: #f8fafc;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    min-height: 35px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::handle:vertical:pressed {
    background-color: #64748b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: #f8fafc;
    height: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    min-width: 35px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #64748b;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

#ProductCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

#ProductCard:hover {
    border: 1px solid #1d4ed8;
}

#lblCardThumbnail {
    background-color: #fbfcfd;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #64748b;
}

#lblCardName {
    font-size: 13px;
    font-weight: bold;
}

#lblCardBarcode {
    color: #64748b;
    font-size: 11px;
}

#lblCardPrice {
    color: #1d4ed8;
    font-size: 13px;
    font-weight: bold;
}

#btnCardAdd {
    background-color: #1d4ed8;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
}

#btnCardAdd:hover {
    background-color: #1e3a8a;
}

#frame_shortcuts {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
}

#frame_order {
    background-color: #ffffff;
    border-left: 1px solid #e2e8f0;
}

#frame_order_header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

#lblCustomerBadge {
    background-color: #eff6ff;
    color: #1d4ed8;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
}

#lblCartEmpty {
    color: #64748b;
}

#CartRow {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #f1f5f9;
}

#lblCartItemName,
#lblCartItemTotal {
    font-size: 13px;
    font-weight: bold;
}

#lblCartItemUnitPrice {
    color: #64748b;
    font-size: 12px;
}

#lblCartItemQuantity {
    font-size: 13px;
}

#btnCartMinus,
#btnCartPlus {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}

#btnCartMinus:hover,
#btnCartPlus:hover {
    background-color: #eff6ff;
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}

#btnCartRemove {
    background-color: #ffffff;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}

#btnCartRemove:hover {
    background-color: #fef2f2;
    border: 1px solid #dc2626;
    color: #dc2626;
}

#frame_summary {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
}

#lblSubTotalCaption,
#lblTaxCaption {
    color: #64748b;
    font-size: 13px;
}

#lblSubTotal,
#lblTax {
    font-size: 13px;
}

#lblDiscount {
    color: #dc2626;
    font-size: 13px;
}

#btnEditDiscount {
    background-color: transparent;
    color: #64748b;
    border: none;
    text-align: left;
    font-size: 13px;
}

#btnEditDiscount:hover {
    color: #1d4ed8;
    text-decoration: underline;
}

#line_summary {
    color: #e2e8f0;
    background-color: #e2e8f0;
}

#lblGrandTotal {
    color: #1d4ed8;
}

#btnPayCash,
#btnPayCard,
#btnPayTransfer {
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
}

#btnPayCash:hover,
#btnPayCard:hover,
#btnPayTransfer:hover {
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}

#btnPayCash:checked,
#btnPayCard:checked,
#btnPayTransfer:checked {
    background-color: #eff6ff;
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}

#btnCheckout {
    background-color: #1e3a8a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
}

#btnCheckout:hover {
    background-color: #1d4ed8;
}

#btnCheckout:disabled {
    background-color: #cbd5e1;
    color: #f8fafc;
}</string>

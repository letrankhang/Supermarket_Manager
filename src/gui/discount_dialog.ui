  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #ffffff;
}

QLabel#lblTitle {
    color: #0f172a;
    font-size: 15px;
    font-weight: 600;
    padding: 2px 0;
}

QDoubleSpinBox#spnDiscount {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QDoubleSpinBox#spnDiscount:hover {
    border: 1px solid #94a3b8;
}

QDoubleSpinBox#spnDiscount:focus {
    border: 1px solid #2563eb;
    background-color: #ffffff;
}

QDoubleSpinBox#spnDiscount::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    border-top-right-radius: 7px;
    background-color: transparent;
}

QDoubleSpinBox#spnDiscount::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    border-bottom-right-radius: 7px;
    background-color: transparent;
}

QDoubleSpinBox#spnDiscount::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #64748b;
}

QDoubleSpinBox#spnDiscount::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748b;
}

QDoubleSpinBox#spnDiscount::up-button:hover,
QDoubleSpinBox#spnDiscount::down-button:hover {
    background-color: #f1f5f9;
}

QPushButton#btnApply {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#btnApply:hover {
    background-color: #1d4ed8;
}

QPushButton#btnApply:pressed {
    background-color: #1e40af;
}

QPushButton#btnApply:disabled {
    background-color: #cbd5e1;
    color: #94a3b8;
}

QPushButton#btnCancel {
    background-color: #f8fafc;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#btnCancel:hover {
    background-color: #f1f5f9;
    border: 1px solid #94a3b8;
    color: #334155;
}

QPushButton#btnCancel:pressed {
    background-color: #e2e8f0;
}

QPushButton#btnCancel:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
}</string>

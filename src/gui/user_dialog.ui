   <string>/* QSS gốc từ RetailPro ERP */
QDialog {
    background-color: #ffffff;
}

QLabel {
    font-weight: bold;
    color: #334155;
    font-size: 14px;
}

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
    color: #0f172a;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3b82f6;
}

QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #64748b;
}

QPushButton {
    font-weight: bold;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
}

QPushButton#btnSave {
    background-color: #3b82f6;
    color: white;
}
QPushButton#btnSave:hover { background-color: #2563eb; }

QPushButton#btnCancel {
    background-color: #e2e8f0;
    color: #475569;
}
QPushButton#btnCancel:hover { background-color: #cbd5e1; }
</string>

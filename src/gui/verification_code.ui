      <property name="styleSheet">
       <string notr="true">#code_card {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}

QLabel {
    background-color: transparent;
    border: none;
}

#lblTitle {
    color: #0c2b82;
    font-size: 22px;
    font-weight: bold;
}

#lblSubtitle {
    color: #6b7280;
    font-size: 13px;
}

#dividerLine {
    background-color: #e5e7eb;
    border: none;
}

#lblField {
    color: #374151;
    font-size: 13px;
    font-weight: 600;
}

#lblCopyright {
    color: #9ca3af;
    font-size: 12px;
}

QLineEdit {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 0px 12px;
    background-color: #ffffff;
    color: #111827;
    font-size: 13px;
    selection-background-color: #0c2b82;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #0c2b82;
}

#pushButton_accept {
    background-color: #002b9a;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
}

#pushButton_accept:hover {
    background-color: #00227b;
}

#pushButton_accept:pressed {
    background-color: #001857;
}

#pushButton_accept:disabled {
    background-color: #9ca3af;
}

#pushButton_resend, #pushButton_2 {
    background-color: transparent;
    border: none;
    color: #0c2b82;
    font-weight: bold;
    font-size: 13px;
}

#pushButton_resend:hover, #pushButton_2:hover {
    color: #081d59;
    text-decoration: underline;
}

#pushButton_resend:disabled {
    color: #9ca3af;
    text-decoration: none;
}

#lblBackLogin {
    background-color: transparent;
    border: none;
    color: #0c2b82;
    font-weight: bold;
    font-size: 13px;
}

#lblBackLogin:hover {
    color: #081d59;
    text-decoration: underline;
}</string>

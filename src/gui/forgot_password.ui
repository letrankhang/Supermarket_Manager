}

QLineEdit {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 0px 12px;
    background-color: #ffffff;
    color: #111827;
    font-size: 13px;
    selection-background-color: #0c2b82;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #0c2b82;
}

#pushButton_accept {
    background-color: #002b9a;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
}

#pushButton_accept:hover {
    background-color: #00227b;
}

#pushButton_accept:pressed {
    background-color: #001857;
}

#pushButton_accept:disabled {
    background-color: #9ca3af;
}

#lblBackLogin {
    background-color: transparent;
    border: none;
    color: #0c2b82;
    font-weight: bold;
    font-size: 13px;
}

#lblBackLogin:hover {
    color: #081d59;
    text-decoration: underline;
}</string>

}
QLabel[trend=&quot;flat&quot;] {
    background-color: #f1f5f9;
    color: #64748b;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 700;
}
QLabel[state=&quot;up&quot;] {
    color: #10b981;
    font-weight: bold;
}
QLabel[state=&quot;down&quot;] {
    color: #ef4444;
    font-weight: bold;
}

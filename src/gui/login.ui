       <string notr="true">#login_card {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}

QLabel {
    background-color: transparent;
    border: none;
}

QLineEdit {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 0px 12px;
    background-color: #ffffff;
    color: #111827;
    font-size: 13px;
    selection-background-color: #0c2b82;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #0c2b82;
}

/* Nút con mắt ẩn/hiện mật khẩu nằm bên trong ô mật khẩu */
QToolButton {
    border: none;
    background: transparent;
    padding: 0px;
    margin-right: 4px;
}

QCheckBox {
    background-color: transparent;
    color: #4b5563;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #0c2b82;
}

QCheckBox::indicator:checked {
    background-color: #0c2b82;
    border-color: #0c2b82;
    image: url(assets/images/check.png);
}

#pushButton_forgotpassword {
    background-color: transparent;
    border: none;
    color: #0c2b82;
    font-weight: bold;
    font-size: 13px;
}

#pushButton_forgotpassword:hover {
    color: #081d59;
    text-decoration: underline;
}

#pushButton_login {
    background-color: #002b9a;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
}

#pushButton_login:hover {
    background-color: #00227b;
}

#pushButton_login:pressed {
    background-color: #001857;
}</string>

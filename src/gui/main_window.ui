}
QLabel#lblAvatar {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
}

QFrame#sidebar_frame QPushButton:disabled {
    color: #475569;
    background-color: transparent;
    border-left: 4px solid transparent;
}
